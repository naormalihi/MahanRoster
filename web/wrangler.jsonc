// Cloudflare Workers with static assets: serves the built app from dist/.
// Build settings in Cloudflare: Root directory = web, Build command = npm run build,
// Deploy command = npx wrangler deploy, build variables VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
{
  "name": "mahanroster",
  "compatibility_date": "2026-10-01",
  // branch builds run `wrangler preview`, which requires this block (it may stay empty)
  "previews": {},
  "assets": {
    "directory": "./dist",
    // client-side routes (/roster …) fall back to index.html
    "not_found_handling": "single-page-application"
  }
}
